{
  "multipart": [
    {
      "when": {"powered": "false", "facing": "north"},
      "apply": {"model": "crimsoncoppergrid:block/switch_off"}
    },
    {
      "when": {"powered": "false", "facing": "east"},
      "apply": {"model": "crimsoncoppergrid:block/switch_off", "y": 90}
    },
    {
      "when": {"powered": "false", "facing": "south"},
      "apply": {"model": "crimsoncoppergrid:block/switch_off", "y": 180}
    },
    {
      "when": {"powered": "false", "facing": "west"},
      "apply": {"model": "crimsoncoppergrid:block/switch_off", "y": 270}
    },
    {
      "when": {"powered": "true", "facing": "north"},
      "apply": {"model": "crimsoncoppergrid:block/switch_on"}
    },
    {
      "when": {"powered": "true", "facing": "east"},
      "apply": {"model": "crimsoncoppergrid:block/switch_on", "y": 90}
    },
    {
      "when": {"powered": "true", "facing": "south"},
      "apply": {"model": "crimsoncoppergrid:block/switch_on", "y": 180}
    },
    {
      "when": {"powered": "true", "facing": "west"},
      "apply": {"model": "crimsoncoppergrid:block/switch_on", "y": 270}
    },
    {
      "when": {"north": "true"},
      "apply": {"model": "crimsoncoppergrid:block/cable_arm"}
    },
    {
      "when": {"east": "true"},
      "apply": {"model": "crimsoncoppergrid:block/cable_arm", "y": 90}
    },
    {
      "when": {"south": "true"},
      "apply": {"model": "crimsoncoppergrid:block/cable_arm", "y": 180}
    },
    {
      "when": {"west": "true"},
      "apply": {"model": "crimsoncoppergrid:block/cable_arm", "y": 270}
    },
    {
      "when": {"up": "true"},
      "apply": {"model": "crimsoncoppergrid:block/cable_arm", "x": -90}
    },
    {
      "when": {"down": "true"},
      "apply": {"model": "crimsoncoppergrid:block/cable_arm", "y": 180, "x": 90}
    }
  ]
}
