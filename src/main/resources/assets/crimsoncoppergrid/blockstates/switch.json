{
  "multipart": [
    {
      "when": {
        "powered": "false"
      },
      "apply": {
        "model": "crimsoncoppergrid:block/switch_off"
      }
    },
    {
      "when": {
        "powered": "true"
      },
      "apply": {
        "model": "crimsoncoppergrid:block/switch_on"
      }
    }
  ]
}
